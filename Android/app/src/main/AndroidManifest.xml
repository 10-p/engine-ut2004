<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read the ~11 GB game tree in place from external storage (no copy). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Legacy storage for older handhelds (Android <=10 / API <=29, e.g. Retroid on Android 9):
         MANAGE_EXTERNAL_STORAGE is API 30+, so on those devices the engine reads game data (incl.
         a physical SD card) via these runtime perms. Ignored/superseded on API 30+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <!-- Launcher: gates MANAGE_EXTERNAL_STORAGE, then starts the game process. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SDL game process (separate ":game" process so it can be cleanly torn down).
             launchMode=singleTask so relaunching the app (tapping the icon while the :game
             process is still alive) REUSES this instance (onNewIntent) instead of creating a
             second GameActivity, which would re-run SDL_main in the live process and abort the
             engine's one-shot init (Assertion failed: !MemInited). -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|smallestScreenSize|screenLayout" />
    </application>
</manifest>
