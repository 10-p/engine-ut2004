<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for running the game in place from shared storage outside the app's own folder (/sdcard/UT2004,
         an SD card's UT2004): All files access, asked for then. A folder chosen with the folder picker and
         copied into internal storage, or a UT2004 folder in Android/data/com.ut2004.android/files, needs none. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- The same on Android 10 and earlier (API <= 29), where MANAGE_EXTERNAL_STORAGE does not exist:
         these runtime permissions, asked for at the same point. Superseded on API 30+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <!-- Launcher: where the game folder is (the internal copy, made from a folder chosen with the
             folder picker, or a UT2004 folder in place), copying and clearing the internal copy; starts the
             game process. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SDL game process (separate ":game" process so it can be cleanly torn down).
             launchMode=singleTask so relaunching the app (tapping the icon while the :game
             process is still alive) REUSES this instance (onNewIntent) instead of creating a
             second GameActivity, which would re-run SDL_main in the live process and abort the
             engine's one-shot init (Assertion failed: !MemInited). -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|smallestScreenSize|screenLayout" />
    </application>
</manifest>
